GROQ_API_KEY=your_groq_api_key_here
# Comma-separated browser origins allowed to call the API (required for Vercel + local dev)
# CORS_ORIGINS=https://your-app.vercel.app,http://localhost:3000
# Set to 1 on low-memory hosts (Render free tier) to skip Layer 2 embeddings
# SKIP_LAYER2=1
# Optional: path to tesseract.exe if not in PATH (Windows auto-detects Program Files)
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# Secret used to sign user session JWTs — set a long random value in production
# JWT_SECRET=change-me-to-a-long-random-string
# Optional: override SQLite path for user accounts/profiles/history
# RESUMEMATCH_DB=/var/data/resumematch.db
# Optional: Langfuse LLM observability — traces Groq rewrite + chat calls.
# Leave unset to disable tracing (app works normally). Get keys at cloud.langfuse.com
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
